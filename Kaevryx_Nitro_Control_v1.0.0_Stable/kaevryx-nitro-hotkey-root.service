[Unit]
Description=Kaevryx Nitro Control Physical Nitro Hotkey
After=systemd-udevd.service kaevryx-nitro-control.service
Requires=kaevryx-nitro-control.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/kaevryx-nitro-control/knc_hotkey_root.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
